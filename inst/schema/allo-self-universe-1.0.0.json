{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "allo-self-universe-1.0.0",
  "$ref": "#/$defs/universe",
  "$defs": {
    "evaluability": {
      "type": "object",
      "properties": {
        "status": {
          "enum": [
            "evaluated",
            "insufficient",
            "ambiguous",
            "unavailable",
            "unsupported",
            "failed",
            "insufficient_search",
            "not_applicable",
            "not_evaluated"
          ]
        },
        "reason_codes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "required_components": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "examined_components": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "scope": {
          "type": "string",
          "minLength": 1
        },
        "evidence_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "value": {
          "type": "null"
        }
      },
      "required": [
        "status",
        "reason_codes",
        "required_components",
        "examined_components",
        "scope",
        "evidence_refs",
        "value"
      ],
      "additionalProperties": false
    },
    "interval": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "start": {
          "type": "integer",
          "minimum": 1
        },
        "end": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "name",
        "start",
        "end"
      ],
      "additionalProperties": false
    },
    "universe_semantics": {
      "type": "object",
      "properties": {
        "self_subject_id": {
          "type": "string",
          "minLength": 1
        },
        "scope": {
          "enum": [
            "corresponding_hla",
            "all_self_hla"
          ]
        },
        "required_loci": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true,
          "minItems": 1
        },
        "required_domains": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true,
          "minItems": 1
        },
        "isoform_policy": {
          "const": "explicit_mapped_isoforms"
        },
        "sequence_policy": {
          "enum": [
            "precursor",
            "mature"
          ]
        },
        "scenario": {
          "type": "string",
          "pattern": "^allo-context-id-v1:[a-f0-9]{64}$"
        },
        "sequences": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "sequence_id": {
                "type": "string",
                "pattern": "^hla-source-sequence-id-v1:[a-f0-9]{64}$"
              },
              "domains": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/interval"
                }
              },
              "covered_regions": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/interval"
                }
              }
            },
            "required": [
              "sequence_id",
              "domains",
              "covered_regions"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "self_subject_id",
        "scope",
        "required_loci",
        "required_domains",
        "isoform_policy",
        "sequence_policy",
        "scenario",
        "sequences"
      ],
      "additionalProperties": false
    },
    "universe": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": "allo-self-universe-1.0.0"
        },
        "self_universe_id": {
          "type": "string",
          "pattern": "^self-universe-id-v1:[a-f0-9]{64}$"
        },
        "semantics": {
          "$ref": "#/$defs/universe_semantics"
        },
        "reference_policy_id": {
          "type": "string",
          "pattern": "^allo-policy-id-v1:[a-f0-9]{64}$"
        },
        "coverage_complete_for_requested_scope": {
          "type": "boolean"
        },
        "biological_self_completeness_established": {
          "const": false
        },
        "comparison_status": {
          "const": "not_evaluated"
        },
        "search_performed": {
          "const": false
        },
        "evaluability": {
          "$ref": "#/$defs/evaluability"
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "typing_scenario_id": {
          "type": "string",
          "minLength": 1
        },
        "catalog_complete": {
          "type": "boolean"
        },
        "typing_evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/typing"
          }
        }
      },
      "required": [
        "schema_version",
        "self_universe_id",
        "semantics",
        "reference_policy_id",
        "coverage_complete_for_requested_scope",
        "biological_self_completeness_established",
        "comparison_status",
        "search_performed",
        "evaluability",
        "limitations",
        "typing_scenario_id",
        "catalog_complete",
        "typing_evidence"
      ],
      "additionalProperties": false
    },
    "typing": {
      "type": "object",
      "properties": {
        "subject_id": {
          "type": "string",
          "minLength": 1
        },
        "typing_scenario_id": {
          "type": "string",
          "minLength": 1
        },
        "locus": {
          "enum": [
            "A",
            "B",
            "C",
            "E",
            "F",
            "G",
            "DRA",
            "DRB1",
            "DRB3",
            "DRB4",
            "DRB5",
            "DQA1",
            "DQB1",
            "DPA1",
            "DPB1"
          ]
        },
        "complete": {
          "type": "boolean"
        },
        "copy_number": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "phase": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "hla_class": {
          "enum": [
            "I",
            "II"
          ]
        },
        "raw_alleles": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "normalized_alleles": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "compatible_alleles": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^HLA-[A-Z0-9]+\\*[0-9]{2,3}(:[0-9]{2,3}){1,3}[NLSCAQ]?$"
          },
          "uniqueItems": true
        },
        "sequence_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^hla-source-sequence-id-v1:[a-f0-9]{64}$"
          },
          "uniqueItems": true
        },
        "expression_annotations": {
          "type": "array",
          "items": {
            "enum": [
              "N",
              "L",
              "S",
              "C",
              "A",
              "Q"
            ]
          },
          "uniqueItems": true
        },
        "resolved_allele": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^HLA-[A-Z0-9]+\\*[0-9]{2,3}(:[0-9]{2,3}){1,3}[NLSCAQ]?$"
            },
            {
              "type": "null"
            }
          ]
        },
        "resolution_operation": {
          "enum": [
            "unresolved",
            "exact_pinned_mapping",
            "pinned_sequence_equivalence_without_genotype_imputation"
          ]
        },
        "evaluability": {
          "$ref": "#/$defs/evaluability"
        }
      },
      "required": [
        "subject_id",
        "typing_scenario_id",
        "locus",
        "complete",
        "copy_number",
        "phase",
        "hla_class",
        "raw_alleles",
        "normalized_alleles",
        "compatible_alleles",
        "sequence_ids",
        "expression_annotations",
        "resolved_allele",
        "resolution_operation",
        "evaluability"
      ],
      "additionalProperties": false
    }
  },
  "description": "Phase A only. Semantic payloads and physical provenance are separate. No peptide/pMHC/count structures. Runtime validates relational constraints and rederives IDs."
}
