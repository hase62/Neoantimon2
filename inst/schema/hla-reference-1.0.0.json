{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "hla-reference-1.0.0",
  "$ref": "#/$defs/reference",
  "$defs": {
    "provenance": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "minLength": 1
        },
        "retrieved_at": {
          "type": "string",
          "minLength": 1
        },
        "source_url": {
          "type": "string",
          "minLength": 1
        },
        "license": {
          "type": "string",
          "minLength": 1
        },
        "cell_lineage": {
          "type": "string",
          "minLength": 1
        },
        "cellular_origin_evidence_ref": {
          "type": "string",
          "minLength": 1
        },
        "sampling_time": {
          "type": "string",
          "minLength": 1
        },
        "display_label": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "empty_or_provenance": {
      "anyOf": [
        {
          "$ref": "#/$defs/provenance"
        },
        {
          "type": "array",
          "maxItems": 0
        }
      ]
    },
    "interval": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "start": {
          "type": "integer",
          "minimum": 1
        },
        "end": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "name",
        "start",
        "end"
      ],
      "additionalProperties": false
    },
    "coordinates": {
      "type": "object",
      "properties": {
        "sequence_coordinates": {
          "enum": [
            "precursor",
            "mature"
          ]
        },
        "precursor_start": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "mature_start": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "sequence_coordinates",
        "precursor_start",
        "mature_start"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "sequence_coordinates": {
                "const": "precursor"
              }
            }
          },
          "then": {
            "properties": {
              "precursor_start": {
                "const": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "sequence_coordinates": {
                "const": "mature"
              }
            }
          },
          "then": {
            "properties": {
              "mature_start": {
                "const": 1
              }
            }
          }
        }
      ]
    },
    "provider": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "name",
        "version"
      ],
      "additionalProperties": false
    },
    "sequence_input": {
      "type": "object",
      "properties": {
        "allele": {
          "type": "string",
          "pattern": "^HLA-[A-Z0-9]+\\*[0-9]{2,3}(:[0-9]{2,3}){1,3}[NLSCAQ]?$"
        },
        "sequence_identifier": {
          "type": "string",
          "minLength": 1
        },
        "protein_sequence": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[ACDEFGHIKLMNPQRSTVWYX]+$"
            },
            {
              "type": "null"
            }
          ]
        },
        "sequence_status": {
          "enum": [
            "complete",
            "partial",
            "unavailable"
          ]
        },
        "supported": {
          "type": "boolean"
        },
        "protein_definition": {
          "type": "string",
          "minLength": 1
        },
        "isoform": {
          "type": "string",
          "minLength": 1
        },
        "coordinate_map": {
          "$ref": "#/$defs/coordinates"
        },
        "domains": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/interval"
          }
        },
        "covered_regions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/interval"
          }
        },
        "resolution_provenance": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "allele",
        "sequence_identifier",
        "protein_sequence",
        "sequence_status",
        "supported",
        "protein_definition",
        "isoform",
        "coordinate_map",
        "domains",
        "covered_regions",
        "resolution_provenance"
      ],
      "additionalProperties": false
    },
    "sequence": {
      "type": "object",
      "properties": {
        "allele": {
          "type": "string",
          "pattern": "^HLA-[A-Z0-9]+\\*[0-9]{2,3}(:[0-9]{2,3}){1,3}[NLSCAQ]?$"
        },
        "sequence_identifier": {
          "type": "string",
          "minLength": 1
        },
        "protein_sequence": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[ACDEFGHIKLMNPQRSTVWYX]+$"
            },
            {
              "type": "null"
            }
          ]
        },
        "sequence_status": {
          "enum": [
            "complete",
            "partial",
            "unavailable"
          ]
        },
        "supported": {
          "type": "boolean"
        },
        "protein_definition": {
          "type": "string",
          "minLength": 1
        },
        "isoform": {
          "type": "string",
          "minLength": 1
        },
        "coordinate_map": {
          "$ref": "#/$defs/coordinates"
        },
        "domains": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/interval"
          }
        },
        "covered_regions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/interval"
          }
        },
        "resolution_provenance": {
          "type": "string",
          "minLength": 1
        },
        "unknown_positions": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 1
          },
          "uniqueItems": true
        },
        "expression_annotation": {
          "anyOf": [
            {
              "enum": [
                "N",
                "L",
                "S",
                "C",
                "A",
                "Q"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "hla_source_sequence_id": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^hla-source-sequence-id-v1:[a-f0-9]{64}$"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "allele",
        "sequence_identifier",
        "protein_sequence",
        "sequence_status",
        "supported",
        "protein_definition",
        "isoform",
        "coordinate_map",
        "domains",
        "covered_regions",
        "resolution_provenance",
        "unknown_positions",
        "expression_annotation",
        "hla_source_sequence_id"
      ],
      "additionalProperties": false
    },
    "manifest": {
      "type": "object",
      "properties": {
        "version": {
          "const": "hla-reference-1.0.0"
        },
        "reference_source": {
          "type": "string",
          "minLength": 1
        },
        "reference_release": {
          "type": "string",
          "minLength": 1
        },
        "nomenclature_authority": {
          "type": "string",
          "minLength": 1
        },
        "nomenclature_release": {
          "type": "string",
          "minLength": 1
        },
        "species": {
          "const": "NCBITaxon:9606"
        },
        "provider": {
          "$ref": "#/$defs/provider"
        },
        "parser": {
          "$ref": "#/$defs/provider"
        },
        "coordinate_convention": {
          "const": "one_based_inclusive"
        },
        "isoform_policy": {
          "const": "explicit_mapped_isoforms"
        },
        "completion_policy": {
          "const": "none"
        },
        "sequence_policy": {
          "enum": [
            "precursor",
            "mature"
          ]
        },
        "status": {
          "enum": [
            "evaluated",
            "failed"
          ]
        },
        "records": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/sequence_input"
          }
        },
        "provenance": {
          "$ref": "#/$defs/provenance"
        },
        "reason_codes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "version",
        "reference_source",
        "reference_release",
        "nomenclature_authority",
        "nomenclature_release",
        "species",
        "provider",
        "parser",
        "coordinate_convention",
        "isoform_policy",
        "completion_policy",
        "sequence_policy",
        "status",
        "records"
      ],
      "additionalProperties": false
    },
    "reference_semantics": {
      "type": "object",
      "properties": {
        "version": {
          "const": "hla-reference-1.0.0"
        },
        "reference_source": {
          "type": "string",
          "minLength": 1
        },
        "reference_release": {
          "type": "string",
          "minLength": 1
        },
        "nomenclature_authority": {
          "type": "string",
          "minLength": 1
        },
        "nomenclature_release": {
          "type": "string",
          "minLength": 1
        },
        "species": {
          "const": "NCBITaxon:9606"
        },
        "provider": {
          "$ref": "#/$defs/provider"
        },
        "parser": {
          "$ref": "#/$defs/provider"
        },
        "coordinate_convention": {
          "const": "one_based_inclusive"
        },
        "isoform_policy": {
          "const": "explicit_mapped_isoforms"
        },
        "completion_policy": {
          "const": "none"
        },
        "sequence_policy": {
          "enum": [
            "precursor",
            "mature"
          ]
        }
      },
      "required": [
        "version",
        "reference_source",
        "reference_release",
        "nomenclature_authority",
        "nomenclature_release",
        "species",
        "provider",
        "parser",
        "coordinate_convention",
        "isoform_policy",
        "completion_policy",
        "sequence_policy"
      ],
      "additionalProperties": false
    },
    "artifact": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "path",
        "sha256"
      ],
      "additionalProperties": false
    },
    "reference": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": "hla-reference-1.0.0"
        },
        "reference_policy_id": {
          "type": "string",
          "pattern": "^allo-policy-id-v1:[a-f0-9]{64}$"
        },
        "semantics": {
          "$ref": "#/$defs/reference_semantics"
        },
        "records": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/sequence"
          }
        },
        "status": {
          "enum": [
            "evaluated",
            "failed"
          ]
        },
        "reason_codes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "provenance": {
          "type": "object",
          "properties": {
            "artifact": {
              "$ref": "#/$defs/artifact"
            },
            "metadata": {
              "$ref": "#/$defs/empty_or_provenance"
            }
          },
          "required": [
            "artifact",
            "metadata"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "schema_version",
        "reference_policy_id",
        "semantics",
        "records",
        "status",
        "reason_codes",
        "provenance"
      ],
      "additionalProperties": false
    }
  },
  "description": "Phase A only. Semantic payloads and physical provenance are separate. No peptide/pMHC/count structures. Runtime validates relational constraints and rederives IDs."
}
