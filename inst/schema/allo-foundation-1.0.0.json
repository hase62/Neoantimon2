        },
        "provider": {
          "$ref": "#/$defs/provider"
        },
        "parser": {
          "$ref": "#/$defs/provider"
        },
        "coordinate_convention": {
          "const": "one_based_inclusive"
        },
        "isoform_policy": {
          "const": "explicit_mapped_isoforms"
        },
        "completion_policy": {
          "const": "none"
        },
        "sequence_policy": {
          "enum": [
            "precursor",
            "mature"
          ]
        }
      },
      "required": [
        "version",
        "reference_source",
        "reference_release",
        "nomenclature_authority",
        "nomenclature_release",
        "species",
        "provider",
        "parser",
        "coordinate_convention",
        "isoform_policy",
        "completion_policy",
        "sequence_policy"
      ],
      "additionalProperties": false
    },
    "artifact": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "path",
        "sha256"
      ],
      "additionalProperties": false
    },
    "reference": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": "hla-reference-1.0.0"
        },
        "reference_policy_id": {
          "type": "string",
          "pattern": "^allo-policy-id-v1:[a-f0-9]{64}$"
        },
        "semantics": {
          "$ref": "#/$defs/reference_semantics"
        },
        "records": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/sequence"
          }
        },
        "status": {
          "enum": [
            "evaluated",
            "failed"
          ]
        },
        "reason_codes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "provenance": {
          "type": "object",
          "properties": {
            "artifact": {
              "$ref": "#/$defs/artifact"
            },
            "metadata": {
              "$ref": "#/$defs/empty_or_provenance"
            }
          },
          "required": [
            "artifact",
            "metadata"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "schema_version",
        "reference_policy_id",
        "semantics",
        "records",
        "status",
        "reason_codes",
        "provenance"
      ],
      "additionalProperties": false
    },
    "typing_input": {
      "type": "object",
      "properties": {
        "subject_id": {
          "type": "string",
          "minLength": 1
        },
        "typing_scenario_id": {
          "type": "string",
          "minLength": 1
        },
        "locus": {
          "enum": [
            "A",
            "B",
            "C",
            "E",
            "F",
            "G",
            "DRA",
            "DRB1",
            "DRB3",
            "DRB4",
            "DRB5",
            "DQA1",
            "DQB1",
            "DPA1",
            "DPB1"
          ]
        },
        "alleles": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "complete": {
          "type": "boolean"
        },
        "copy_number": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "phase": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "subject_id",
        "typing_scenario_id",
        "locus",
        "alleles",
        "complete",
        "copy_number",
        "phase"
      ],
      "additionalProperties": false
    },
    "typing": {
      "type": "object",
      "properties": {
        "subject_id": {
          "type": "string",
          "minLength": 1
        },
        "typing_scenario_id": {
          "type": "string",
          "minLength": 1
        },
        "locus": {
          "enum": [
            "A",
            "B",
            "C",
            "E",
            "F",
            "G",
            "DRA",
            "DRB1",
            "DRB3",
            "DRB4",
            "DRB5",
            "DQA1",
            "DQB1",
            "DPA1",
            "DPB1"
          ]
        },
        "complete": {
          "type": "boolean"
        },
        "copy_number": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "phase": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "hla_class": {
          "enum": [
            "I",
            "II"
          ]
        },
        "raw_alleles": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
