{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "indirect-hla-baseline-1.0.0",
  "title": "indirect-hla-baseline-1.0.0",
  "$ref": "#/$defs/baseline",
  "$defs": {
    "threshold": {
      "type": "object",
      "properties": {
        "version": {
          "const": "strict-affinity-1000nm-1.0.0"
        },
        "profile": {
          "const": "neo-literature-derived-indirect-hla-ii-dr-strict-v1"
        },
        "dimension": {
          "const": "binding_affinity"
        },
        "comparator": {
          "const": "<"
        },
        "value": {
          "const": 1000
        },
        "unit": {
          "const": "nM"
        },
        "precision": {
          "const": "raw_no_rounding"
        },
        "citation": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "version",
        "profile",
        "dimension",
        "comparator",
        "value",
        "unit",
        "precision",
        "citation"
      ],
      "additionalProperties": false
    },
    "binding": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "manifest": {
          "$ref": "#/$defs/import"
        }
      },
      "required": [
        "path"
      ],
      "additionalProperties": false
    },
    "presenter_input": {
      "type": "object",
      "properties": {
        "scenario_id": {
          "type": "string",
          "minLength": 1
        },
        "subject_id": {
          "type": "string",
          "minLength": 1
        },
        "presenter": {
          "type": "string",
          "minLength": 1
        },
        "resolution_policy": {
          "const": "explicit_typed_alpha_beta"
        }
      },
      "required": [
        "scenario_id",
        "subject_id",
        "presenter",
        "resolution_policy"
      ],
      "additionalProperties": false
    },
    "config": {
      "type": "object",
      "properties": {
        "version": {
          "const": "indirect-hla-baseline-1.0.0"
        },
        "profile": {
          "const": "neo-literature-derived-indirect-hla-ii-dr-strict-v1"
        },
        "presenters": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/presenter_input"
          }
        },
        "provider": {
          "$ref": "#/$defs/binding"
        }
      },
      "required": [
        "version",
        "profile",
        "presenters",
        "provider"
      ],
      "additionalProperties": false
    },
    "provider": {
      "type": "object",
      "properties": {
        "name": {
          "const": "NetMHCIIpan"
        },
        "version": {
          "type": "string",
          "pattern": "^3\\.2($|\\.)"
        },
        "build": {
          "type": "string",
          "minLength": 1
        },
        "model": {
          "type": "string",
          "minLength": 1
        },
        "task": {
          "const": "mhc2_binding"
        },
        "prediction_mode": {
          "const": "BA"
        },
        "species": {
          "const": "NCBITaxon:9606"
        },
        "arguments": {
          "type": "object",
          "properties": {
            "BA": {
              "const": true
            }
          },
          "required": [
            "BA"
          ],
          "additionalProperties": false
        },
        "supported_presenters": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "supported_lengths": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 1
          },
          "minItems": 1
        },
        "calibration": {
          "type": "string",
          "minLength": 1
        },
        "batching": {
          "type": "string",
          "minLength": 1
        },
        "evidence_kind": {
          "enum": [
            "synthetic_fixture",
            "precomputed_predictor_output"
          ]
        }
      },
      "required": [
        "name",
        "version",
        "build",
        "model",
        "task",
        "prediction_mode",
        "species",
        "arguments",
        "supported_presenters",
        "supported_lengths",
        "calibration",
        "batching",
        "evidence_kind"
      ],
      "additionalProperties": false
    },
    "core": {
      "type": "object",
      "properties": {
        "core_sequence": {
          "type": "string",
          "pattern": "^[ACDEFGHIKLMNPQRSTVWY]{9}$"
        },
        "offset": {
          "type": "integer",
          "minimum": 0,
          "maximum": 6
        },
        "orientation": {
          "enum": [
            "forward",
            "reverse",
            "unknown"
          ]
        },
        "register": {
          "type": "string",
          "minLength": 1
        },
        "primary": {
          "type": "boolean"
        },
        "status": {
          "enum": [
            "evaluated",
            "ambiguous",
            "unresolved_mapping",
            "unsupported"
          ]
        }
      },
      "required": [
        "core_sequence",
        "offset",
        "orientation",
        "register",
        "primary",
        "status"
      ],
      "additionalProperties": false
    },
    "raw_row": {
      "type": "object",
      "properties": {
        "peptide_sequence": {
          "type": "string",
          "pattern": "^[ACDEFGHIKLMNPQRSTVWY]{15}$"
        },
        "presenter": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": [
            "evaluated",
            "unsupported",
            "unavailable",
            "failed",
            "ambiguous",
            "not_applicable"
          ]
        },
        "affinity_nM": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "percentile_rank": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0,
              "maximum": 100
            },
            {
              "type": "null"
            }
          ]
        },
        "cores": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/core"
          }
        },
        "raw_output": {
          "type": "object"
        },
        "reason_codes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "provenance": {
          "type": "object"
        }
      },
      "required": [
        "peptide_sequence",
        "presenter",
        "status",
        "affinity_nM",
        "percentile_rank",
        "cores",
        "raw_output",
        "reason_codes"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "evaluated"
              }
            }
          },
          "then": {
            "properties": {
              "affinity_nM": {
                "type": "number",
                "minimum": 0
              }
            }
          },
          "else": {
            "properties": {
              "affinity_nM": {
                "type": "null"
              },
              "cores": {
                "type": "array",
                "maxItems": 0
              }
            }
          }
        }
      ]
    },
    "import": {
      "type": "object",
      "properties": {
        "version": {
          "const": "indirect-binding-import-1.0.0"
        },
        "provider": {
          "$ref": "#/$defs/provider"
        },
        "rows": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/raw_row"
          }
        },
        "provenance": {
          "$ref": "#/$defs/provider_provenance"
        }
      },
      "required": [
        "version",
        "provider",
        "rows",
        "provenance"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "provider": {
                "properties": {
                  "evidence_kind": {
                    "const": "synthetic_fixture"
                  }
                }
              }
            }
          },
          "then": {
            "properties": {
              "provenance": {
                "$ref": "#/$defs/synthetic_provenance"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "provider": {
                "properties": {
                  "evidence_kind": {
                    "const": "precomputed_predictor_output"
                  }
                }
              }
            }
          },
          "then": {
            "properties": {
              "provenance": {
                "$ref": "#/$defs/precomputed_provenance"
              }
            }
          }
        }
      ]
    },
    "evidence": {
      "type": "object",
      "properties": {
        "peptide_sequence": {
          "type": "string",
          "pattern": "^[ACDEFGHIKLMNPQRSTVWY]{15}$"
        },
        "presenter": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": [
            "evaluated",
            "unsupported",
            "unavailable",
            "failed",
            "ambiguous",
            "not_applicable"
          ]
        },
        "affinity_nM": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "percentile_rank": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0,
              "maximum": 100
            },
            {
              "type": "null"
            }
          ]
        },
        "cores": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/core"
          }
        },
        "raw_output": {
          "anyOf": [
            {
              "type": "object"
            },
            {
              "type": "array",
              "maxItems": 0
            }
          ]
        },
        "reason_codes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "provenance": {
          "type": "array",
          "items": {
            "anyOf": [
              {
                "type": "object"
              },
              {
                "type": "array",
                "maxItems": 0
              }
            ]
          }
        },
        "evidence_id": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^indirect-evidence-id-v1:[0-9a-f]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "raw_output_alternatives": {
          "type": "array",
          "items": {
            "type": "object"
          }
        }
      },
      "required": [
        "peptide_sequence",
        "presenter",
        "status",
        "affinity_nM",
        "percentile_rank",
        "cores",
        "raw_output",
        "reason_codes",
        "provenance",
        "evidence_id",
        "raw_output_alternatives"
      ],
      "additionalProperties": false
    },
    "occurrence_payload": {
      "type": "object",
      "properties": {
        "source_occurrence_id": {
          "type": "string",
          "pattern": "^hla-source-occurrence-id-v1:[0-9a-f]{64}$"
        },
        "start": {
          "type": "integer",
          "minimum": 1
        },
        "end": {
          "type": "integer",
          "minimum": 1
        },
        "peptide_key": {
          "type": "string",
          "pattern": "^peptide_key:[0-9a-f]{64}$"
        },
        "generation_policy_id": {
          "type": "string",
          "pattern": "^allo-policy-id-v1:[0-9a-f]{64}$"
        }
      },
      "required": [
        "source_occurrence_id",
        "start",
        "end",
        "peptide_key",
        "generation_policy_id"
      ],
      "additionalProperties": false
    },
    "interval": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "start": {
          "type": "integer",
          "minimum": 1
        },
        "end": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "name",
        "start",
        "end"
      ],
      "additionalProperties": false
    },
    "occurrence": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": "indirect-peptide-occurrence-1.0.0"
        },
        "indirect_peptide_occurrence_id": {
          "type": "string",
          "pattern": "^indirect-peptide-occurrence-id-v1:[0-9a-f]{64}$"
        },
        "semantics": {
          "$ref": "#/$defs/occurrence_payload"
        },
        "hla_source_sequence_id": {
          "type": "string",
          "pattern": "^hla-source-sequence-id-v1:[0-9a-f]{64}$"
        },
        "source_subject_id": {
          "type": "string",
          "minLength": 1
        },
        "source_allele_hypothesis": {
          "type": "string",
          "minLength": 1
        },
        "sequence_coordinates": {
          "const": "precursor"
        },
        "peptide_sequence": {
          "type": "string",
          "pattern": "^[ACDEFGHIKLMNPQRSTVWY]{15}$"
        },
        "domains": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/interval"
          }
        },
        "status": {
          "enum": [
            "evaluated",
            "insufficient"
          ]
        },
        "mismatch_annotation": {
          "type": "object"
        },
        "provenance": {
          "type": "object"
        }
      },
      "required": [
        "schema_version",
        "indirect_peptide_occurrence_id",
        "semantics",
        "hla_source_sequence_id",
        "source_subject_id",
        "source_allele_hypothesis",
        "sequence_coordinates",
        "peptide_sequence",
        "domains",
        "status",
        "mismatch_annotation",
        "provenance"
      ],
      "additionalProperties": false
    },
    "comparison_payload": {
      "type": "object",
      "properties": {
        "query_identity": {
          "type": "string",
          "minLength": 1
        },
        "query_type": {
          "enum": [
            "full_peptide",
            "core_pmhc"
          ]
        },
        "self_universe_id": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^self-universe-id-v1:[0-9a-f]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "algorithm": {
          "type": "object"
        },
        "self_presentation_policy": {
          "anyOf": [
            {
              "type": "object"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "query_identity",
        "query_type",
        "self_universe_id",
        "algorithm",
        "self_presentation_policy"
      ],
      "additionalProperties": false
    },
    "comparison": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": "self-comparison-1.0.0"
        },
        "self_comparison_id": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^self-comparison-id-v1:[0-9a-f]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "semantics": {
          "$ref": "#/$defs/comparison_payload"
        },
        "self_subject_id": {
          "type": "string",
          "minLength": 1
        },
        "scope": {
          "const": "all_self_hla"
        },
        "status": {
          "enum": [
            "supported_nonself_within_scope",
            "self_match",
            "insufficient_search",
            "not_evaluated",
            "ambiguous",
            "not_applicable"
          ]
        },
        "search_complete": {
          "type": "boolean"
        },
        "biological_self_completeness_established": {
          "const": false
        },
        "reason_codes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "matches": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "occurrence_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^indirect-peptide-occurrence-id-v1:[0-9a-f]{64}$"
          },
          "uniqueItems": true
        },
        "search_ledger": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "provenance": {
          "type": "object"
        }
      },
      "required": [
        "schema_version",
        "self_comparison_id",
        "semantics",
        "self_subject_id",
        "scope",
        "status",
        "search_complete",
        "biological_self_completeness_established",
        "reason_codes",
        "matches",
        "occurrence_ids",
        "search_ledger",
        "provenance"
      ],
      "additionalProperties": false
    },
    "pmhc_payload": {
      "type": "object",
      "properties": {
        "allo_context_id": {
          "type": "string",
          "pattern": "^allo-context-id-v1:[0-9a-f]{64}$"
        },
        "candidate_key": {
          "type": "string",
          "pattern": "^candidate_key:[0-9a-f]{64}$"
        },
        "presenting_compartment": {
          "type": "string",
          "minLength": 1
        },
        "presenting_scenario": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "allo_context_id",
        "candidate_key",
        "presenting_compartment",
        "presenting_scenario"
      ],
      "additionalProperties": false
    },
    "assignment": {
      "type": "object",
      "properties": {
        "indirect_core_assignment_id": {
          "type": "string",
          "pattern": "^indirect-core-assignment-id-v1:[0-9a-f]{64}$"
        },
        "semantics": {
          "type": "object"
        },
        "epitope_key": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^epitope_key:[0-9a-f]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "mismatch_annotation": {
          "type": "object",
          "properties": {
            "status": {
              "const": "not_evaluated"
            },
            "reason_codes": {
              "type": "array",
              "items": {
                "const": "alignment_not_performed"
              },
              "minItems": 1,
              "maxItems": 1
            }
          },
          "required": [
            "status",
            "reason_codes"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "indirect_core_assignment_id",
        "semantics",
        "epitope_key",
        "mismatch_annotation"
      ],
      "additionalProperties": false
    },
    "pmhc": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": "indirect-pmhc-evidence-1.0.0"
        },
        "indirect_pmhc_id": {
          "type": "string",
          "pattern": "^indirect-pmhc-id-v1:[0-9a-f]{64}$"
        },
        "semantics": {
          "$ref": "#/$defs/pmhc_payload"
        },
        "candidate_key": {
          "type": "string",
          "pattern": "^candidate_key:[0-9a-f]{64}$"
        },
        "peptide_key": {
          "type": "string",
          "pattern": "^peptide_key:[0-9a-f]{64}$"
        },
        "peptide_sequence": {
          "type": "string",
          "minLength": 1
        },
        "presenter": {
          "type": "string",
          "minLength": 1
        },
        "hla_class": {
          "enum": [
            "I",
            "II"
          ]
        },
        "occurrence_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^indirect-peptide-occurrence-id-v1:[0-9a-f]{64}$"
          },
          "uniqueItems": true
        },
        "provider_configuration_id": {
          "type": "string",
          "pattern": "^allo-policy-id-v1:[0-9a-f]{64}$"
        },
        "binding_evidence": {
          "$ref": "#/$defs/evidence"
        },
        "threshold_policy": {
          "$ref": "#/$defs/threshold"
        },
        "core_assignments": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/assignment"
          }
        },
        "status": {
          "enum": [
            "evaluated",
            "unsupported",
            "unavailable",
            "failed",
            "ambiguous",
            "not_applicable",
            "insufficient"
          ]
        }
      },
      "required": [
        "schema_version",
        "indirect_pmhc_id",
        "semantics",
        "candidate_key",
        "peptide_key",
        "peptide_sequence",
        "presenter",
        "hla_class",
        "occurrence_ids",
        "provider_configuration_id",
        "binding_evidence",
        "threshold_policy",
        "core_assignments",
        "status"
      ],
      "additionalProperties": false
    },
    "generation": {
      "type": "object",
      "properties": {
        "policy": {
          "type": "object"
        },
        "generation_policy_id": {
          "type": "string",
          "pattern": "^allo-policy-id-v1:[0-9a-f]{64}$"
        },
        "occurrences": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/occurrence"
          }
        },
        "ledger": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "complete": {
          "type": "boolean"
        }
      },
      "required": [
        "policy",
        "generation_policy_id",
        "occurrences",
        "ledger",
        "complete"
      ],
      "additionalProperties": false
    },
    "presenter": {
      "type": "object",
      "properties": {
        "presenter": {
          "type": "string",
          "minLength": 1
        },
        "subject_id": {
          "type": "string",
          "minLength": 1
        },
        "resolution_policy": {
          "const": "explicit_typed_alpha_beta"
        },
        "status": {
          "enum": [
            "evaluated",
            "unsupported",
            "insufficient"
          ]
        },
        "reason_codes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      },
      "required": [
        "presenter",
        "subject_id",
        "resolution_policy",
        "status",
        "reason_codes"
      ],
      "additionalProperties": false
    },
    "search": {
      "type": "object",
      "properties": {
        "presenter": {
          "type": "string",
          "minLength": 1
        },
        "complete": {
          "type": "boolean"
        },
        "hits": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "ledger": {
          "type": "array",
          "items": {
            "type": "object"
          }
        }
      },
      "required": [
        "presenter",
        "complete",
