          <mxGeometry x="638" y="148" width="524" height="56" as="geometry" />
        </mxCell>
        <mxCell id="origins-body" parent="1" vertex="1" value="Event: normalized chr1:4 G&gt;A&#10;Origin: transcript TA.1 + translation path&#10;Origins retain contributing event links.&#10;One event can participate in several paths." style="shape=text;html=0;align=left;fontSize=17.5;fontStyle=0;fontColor=#233746;spacing=0;">
