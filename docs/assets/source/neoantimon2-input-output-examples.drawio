          <mxGeometry x="38" y="305" width="524" height="56" as="geometry" />
        </mxCell>
        <mxCell id="hla-body" parent="1" vertex="1" value="P1: HLA-A*02:01 / HLA-B*07:02&#10;Class II presenter requires both chains:&#10;HLA-DRA*01:01~HLA-DRB1*15:01&#10;User supplied; no automatic HLA typing." style="shape=text;html=0;align=left;fontSize=18;fontStyle=0;fontColor=#233746;spacing=0;">
          <mxGeometry x="38" y="341" width="524" height="88" as="geometry" />
