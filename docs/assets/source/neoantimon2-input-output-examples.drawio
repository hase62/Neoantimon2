          <mxGeometry x="638" y="305" width="524" height="56" as="geometry" />
        </mxCell>
        <mxCell id="candidate-body" parent="1" vertex="1" value="Peptide: SIINFEKLA (illustrative sequence)&#10;Candidate: SIINFEKLA + HLA-A*02:01&#10;Distinct origins may share this peptide.&#10;Keep every origin and each sample occurrence." style="shape=text;html=0;align=left;fontSize=17.5;fontStyle=0;fontColor=#233746;spacing=0;">
          <mxGeometry x="638" y="341" width="524" height="84" as="geometry" />
