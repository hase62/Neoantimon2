        </mxCell>
        <mxCell id="evidence-body" parent="1" vertex="1" value="RNA read / expression evidence&#10;Cancer-cell fraction (CCF) / clonality inputs&#10;Mass-spectrometry (MS) observations&#10;Missing evidence is not a measured negative." style="shape=text;html=0;align=left;fontSize=18;fontStyle=0;fontColor=#233746;spacing=0;">
