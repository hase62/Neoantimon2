          <mxGeometry x="38" y="462" width="524" height="56" as="geometry" />
        </mxCell>
        <mxCell id="refs-body" parent="1" vertex="1" value="GRCh38.p14 genome + matching FAI&#10;GENCODE 50 transcript / protein catalogs&#10;MANE Select 1.5 summary / GTF&#10;Explicit compatible files, not patient attributes." style="shape=text;html=0;align=left;fontSize=18;fontStyle=0;fontColor=#233746;spacing=0;">
