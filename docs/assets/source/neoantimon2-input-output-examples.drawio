          <mxGeometry x="638" y="462" width="524" height="56" as="geometry" />
        </mxCell>
        <mxCell id="pred-body" parent="1" vertex="1" value="Native: NOT_RUN when no provider ran&#10;BA: affinity_nM = 50 (nM; lower is better)&#10;EL: presentation_percentile = 0.8 (percent; lower)&#10;IM: score = 0.7 (unitless; higher)" style="shape=text;html=0;align=left;fontSize=17.5;fontStyle=0;fontColor=#233746;spacing=0;">
