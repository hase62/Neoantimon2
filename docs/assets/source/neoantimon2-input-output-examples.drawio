        </mxCell>
        <mxCell id="identity-body" parent="1" vertex="1" value="P1 → S1, S2; P2 → S3 (explicit mappings)&#10;VCF columns: CHROM POS REF ALT FORMAT S1&#10;Example row: chr1 4 G A GT 0/1&#10;Each VCF has exactly one sample column." style="shape=text;html=0;align=left;fontSize=18;fontStyle=0;fontColor=#233746;spacing=0;">
